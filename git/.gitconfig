[user]
	name = Lucas Santato
	email = lucas@santato.dev
[credential]
	helper = store
[url "git@github.com:Santato7/"]
	insteadOf = "me:"
[url "git@github.com:"]
	insteadOf = "gh:"
[init]
	defaultBranch = main
[includeIf "gitdir:~/projects/ds3/"]
	path = ~/.gitconfig-ds3
[core]
	excludesfile = /home/santato/.gitignore_global
